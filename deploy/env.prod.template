# ============================================================
# RAG Platform 生产环境配置模板
# ============================================================
# 
# 使用方法：
#   1. 复制此文件到项目根目录: cp deploy/env.prod.template .env.prod
#   2. 编辑 .env.prod 填写实际值
#   3. 启动: docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ============================================================

# ==================== 数据库配置 ====================
MYSQL_ROOT_PASSWORD=your_secure_root_password_change_me
MYSQL_DATABASE=rag_platform
MYSQL_USER=rag_user
MYSQL_PASSWORD=your_secure_password_change_me

# ==================== Redis 配置 ====================
REDIS_PASSWORD=your_redis_password_change_me

# ==================== JWT 配置 ====================
# 重要：生成一个强随机密钥，不要使用默认值！
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_must_be_at_least_32_chars

# ==================== 存储配置 ====================
# 存储类型: local, s3, oss, cos
STORAGE_TYPE=s3

# === MinIO 配置 (自托管 S3 兼容存储) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123_change_me

# === AWS S3 配置 ===
S3_ENDPOINT=                     # 留空使用 AWS S3，填写则使用 MinIO
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key
S3_BUCKET=rag-platform-prod
S3_REGION=us-east-1

# === 阿里云 OSS 配置 ===
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY=your_oss_access_key
# OSS_SECRET_KEY=your_oss_secret_key
# OSS_BUCKET=rag-platform-prod

# === 腾讯云 COS 配置 ===
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_BUCKET=rag-platform-prod-xxxxx

# ==================== LLM 配置 ====================
# 至少配置一种 LLM 服务

# === Anthropic Claude (推荐) ===
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# === OpenAI ===
# OPENAI_API_KEY=sk-xxxxx

# === 本地 Ollama ===
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# ==================== 前端配置 ====================
VITE_API_BASE_URL=/api

# ==================== 域名配置 ====================
DOMAIN=your-domain.com

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

