# ============================================
# RAG Platform 生产环境配置模板
# 复制此文件为 .env.production 并填写真实值
# ============================================

# ========== 核心配置（必填） ==========

# Anthropic API Key - Claude 的核心
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT 密钥 - 用于用户认证（生成随机字符串）
# 可用命令生成: openssl rand -hex 32
JWT_SECRET=your-very-long-random-string-for-jwt-signing

# ========== 数据库配置 ==========

MYSQL_ROOT_PASSWORD=your-secure-mysql-password
MYSQL_DATABASE=rag_platform

# ========== 域名配置（生产环境） ==========

# 你的域名
DOMAIN=rag-platform.com

# API 地址（前端需要）
API_URL=https://api.rag-platform.com

# ========== 可选配置 ==========

# Moonshot Kimi K2 (兼容 API，可替代 Anthropic)
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# NFT 功能
# WEB3_ENABLED=true
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/xxx
# RAG_NFT_CONTRACT=0x...
# WEB3_PRIVATE_KEY=0x...

# IPFS (Pinata)
# IPFS_ENABLED=true
# PINATA_JWT=eyJhbGci...

