## Copy to `.env` in the same folder and fill in your real keys.
## DO NOT commit `.env`.

# Where the ai-partner-chat skill repo lives on host
AI_PARTNER_SKILL_SRC="/Users/chaowang/rag platform/ai-partner-chat"

# Where runner creates per-rag_id workspaces
AI_PARTNER_WORKSPACES_DIR="/Users/chaowang/rag platform/rag-platform-mvp/ai_partner_workspaces"

# Claude Code CLI path (npm global bin)
CLAUDE_BIN="/Users/chaowang/.npm-global/bin/claude"

# Use Kimi K2 Thinking (Anthropic-compatible)
ANTHROPIC_BASE_URL="https://api.moonshot.cn/anthropic"
ANTHROPIC_AUTH_TOKEN="替换为你的 Moonshot API Key（不要提交到仓库）"
ANTHROPIC_MODEL="kimi-k2-thinking-turbo"
ANTHROPIC_SMALL_FAST_MODEL="kimi-k2-thinking-turbo"

# Enable note embeddings/indexing (may download large models on first run)
AI_PARTNER_ENABLE_INDEX=1

# Two-stage persona generation controls
# - Stage 1: per-note "persona signals" extraction
# - Stage 2: synthesize personas from signals
AI_PARTNER_PERSONA_MAX_NOTES=20
AI_PARTNER_PERSONA_NOTE_MAX_CHARS=6000
AI_PARTNER_PERSONA_SIGNALS_MAX_CHARS=60000


