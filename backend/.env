# ============================================
# 光源 NFT Web3 配置
# ============================================

# 签名者私钥（从 MetaMask 导出的 NFT Signer 账户私钥）
# 格式：0x + 64位十六进制字符
NFT_SIGNER_PRIVATE_KEY=b9e8ab7715501f75537c35cd49cc901b56714230a641a641342b62632cbc0e87

# Sepolia RPC URL（从 Alchemy 获取）
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/eBbj-BzUwienCKwxt3T9Z
# SparkKnowledgeNFT 合约地址（Remix 部署后复制）
SPARK_NFT_CONTRACT=0x921691b0478A9d08e1dbb152e2D6991729a6402A

# ============================================
# 其他配置
# ============================================
OLLAMA_URL=http://localhost:11434
AI_PARTNER_RUNNER_URL=http://localhost:9001

# ============================================
# MySQL 数据库配置
# ============================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=rag_platform

# 数据库类型：mysql 或 sqlite
DATABASE_TYPE=mysql

# ============================================
# Web3 NFT 铸造配置（RAG 知识 NFT）
# ============================================

# 启用 Web3 功能
WEB3_ENABLED=true

# 网络配置（使用已有的 Sepolia）
WEB3_NETWORK=sepolia
WEB3_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/eBbj-BzUwienCKwxt3T9Z
WEB3_CHAIN_ID=11155111

# RAG Knowledge NFT 合约地址（部署后填写）
RAG_NFT_CONTRACT=0xEF91dB5F656d9e308CBe37Ac53bA1af57e5383D9

# 后端签名私钥（可选，用于服务端签名）
WEB3_PRIVATE_KEY=0xb9e8ab7715501f75537c35cd49cc901b56714230a641a641342b62632cbc0e87

# ============================================
# IPFS 配置 (Pinata)
# ============================================
# 请在 https://app.pinata.cloud/ 创建账号并获取 JWT Token

IPFS_ENABLED=true
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ycGPm9fkvwVbSqdLuhYkVZx_oVLgYNKh44OWdQYbFFY

# 或者使用 API Key/Secret（二选一）
# IPFS_API_KEY=
# IPFS_API_SECRET=

LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b

# Anthropic Claude API (获取: https://console.anthropic.com/)
ANTHROPIC_API_KEY=
